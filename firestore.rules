rules_version = '2';

// 오늘출석 Firestore 보안 규칙 (Phase 2 초안)
// 원칙:
// - 학부모는 자기 자녀(students.parentUid == 본인)의 데이터만 읽기
// - 선생님은 자기 teacherCode 소속 학생/기록만 읽기·쓰기
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // 현재 사용자의 users 문서
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isParent() {
      return isSignedIn() && userDoc().role == 'parent';
    }
    // 이 선생님이 소유한 코드인지
    function ownsCode(code) {
      return isSignedIn() && userDoc().teacherCode == code;
    }

    // ── users ────────────────────────────────────────────
    // 본인 문서만 읽고 쓸 수 있다. (가입 시 최초 생성 포함)
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
                    // 역할은 변경 불가.
                    && request.resource.data.role == resource.data.role
                    // 선생님 코드는 불변, 학부모 코드는 변경 가능(반 전환).
                    && (resource.data.role != 'teacher'
                        || request.resource.data.get('teacherCode', null)
                           == resource.data.get('teacherCode', null));
      allow delete: if false;
    }

    // ── teachers/{code} ──────────────────────────────────
    // 코드 검증을 위해 로그인 사용자는 조회 가능(학부모 가입 시 필요).
    // 생성은 가입 트랜잭션에서 본인 uid로만. 수정/삭제 금지(코드 고정).
    match /teachers/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── students ─────────────────────────────────────────
    match /students/{studentId} {
      // 학부모: 본인 자녀만. 선생님: 자기 코드 소속만.
      allow read: if (isParent() && resource.data.parentUid == request.auth.uid)
                  || ownsCode(resource.data.teacherCode);
      // 학부모 자가등록: 본인을 parentUid로, 존재하는 코드로만 생성.
      // (가입과 동시에 users 문서를 만들므로 role 검사는 하지 않고,
      //  본인 소유 + 유효한 선생님 코드만 확인한다.)
      allow create: if isSignedIn()
                    && request.resource.data.parentUid == request.auth.uid
                    && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherCode));
      // 선생님은 자기 코드 소속 학생 정보 수정 가능.
      // 학부모는 본인 자녀의 이름 수정 + teacherCode를 빈 값으로 비우기(반에서
      // 빼되 아이는 보존)만 가능. 다른 반 코드로 바꾸는 것은 불가.
      allow update: if ownsCode(resource.data.teacherCode)
                    || (isParent()
                        && resource.data.parentUid == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['name', 'teacherCode'])
                        && (request.resource.data.teacherCode
                               == resource.data.teacherCode
                            || request.resource.data.teacherCode == ''));
      // 학부모는 본인 자녀, 선생님은 자기 코드 소속 학생을 삭제 가능.
      allow delete: if (isParent() && resource.data.parentUid == request.auth.uid)
                    || ownsCode(resource.data.teacherCode);
    }

    // ── attendance/{studentId}_{date} (최상위) ───────────
    // 문서에 비정규화된 teacherCode·parentUid로 접근 통제.
    match /attendance/{recordId} {
      allow read: if (isParent() && resource.data.parentUid == request.auth.uid)
                  || ownsCode(resource.data.teacherCode);
      // 등원/하원 체크는 선생님만. 생성 시 본인 코드로만.
      allow create: if ownsCode(request.resource.data.teacherCode);
      // 수정 시 소속 코드 불변.
      allow update: if ownsCode(resource.data.teacherCode)
                    && request.resource.data.teacherCode == resource.data.teacherCode;
      allow delete: if false;
    }
  }
}
